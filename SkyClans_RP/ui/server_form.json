// Picks which layout an ActionForm uses, from the start of its title:
//   "§s§c§1"  -> SkyClans main menu      (skyclans.main_screen)
//   "§s§c§2"  -> SkyClans settings menu  (skyclans.settings_screen)
//   "§s§c§3"  -> SkyClans members menu   (sc_members.screen)
//   "§s§c§4"  -> SkyClans insurance menu (sc_insurance.screen)
//   "§s§c§5"  -> SkyClans raid dispatch  (sc_raid.screen)
//   "§s§c§6"  -> SkyClans tile list      (sc_list.screen) - used by the Sky Shop
//   anything without "§s§c" -> the normal vanilla form, so other add-ons are unaffected
{
  "namespace": "server_form",

  "long_form": {
    "type": "panel",
    "size": [ "100%c", "100%c" ],
    "controls": [
      {
        "vanilla": {
          "type": "panel",
          "size": [ 225, 200 ],
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "((#title_text - '§s§c') = #title_text)",
              "target_property_name": "#visible"
            }
          ],
          "controls": [
            {
              "long_form@common_dialogs.main_panel_no_buttons": {
                "$title_panel": "common_dialogs.standard_title_label",
                "$title_size": [ "100% - 14px", 10 ],
                "size": [ 225, 200 ],
                "$text_name": "#title_text",
                "$title_text_binding_type": "none",
                "$child_control": "server_form.long_form_panel",
                "layer": 2
              }
            }
          ]
        }
      },
      {
        "skyclans_main@skyclans.main_screen": {
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - '§s§c§1') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "skyclans_settings@skyclans.settings_screen": {
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - '§s§c§2') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "skyclans_members@sc_members.screen": {
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - '§s§c§3') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "skyclans_insurance@sc_insurance.screen": {
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - '§s§c§4') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "skyclans_raid@sc_raid.screen": {
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - '§s§c§5') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "skyclans_list@sc_list.screen": {
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - '§s§c§6') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  }
}

// SkyClans "Chain of Command" (members) screen. Title marker "§s§c§3".
//   title (after marker) -> small grey line, e.g. clan name
//   body                 -> info next to the face in the SELECTED panel
//   button 0   -> owner card
//   buttons 1-4 -> the other members / Invite card, 2 x 2 under the owner
//   button 5   -> red button in the SELECTED panel (Kick / Leave / Disband)
//   button 6   -> blue button in the SELECTED panel (Promote / Demote)
//   button 7   -> BACK
// Cards and the red / blue buttons hide when their text is empty.
{
  "namespace": "sc_members",

  "screen": {
    "type": "image",
    "texture": "textures/ui/skyclans/window",
    "size": [ 352, 236 ],
    "controls": [
      {
        "small_line": {
          "type": "label",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 8, 6 ],
          "size": [ 200, 10 ],
          "color": [ 0.62, 0.66, 0.72 ],
          "font_scale_factor": 0.8,
          "text": "#text",
          "bindings": [
            { "binding_name": "#title_text" },
            { "binding_type": "view", "source_property_name": "(#title_text - '§s§c§3')", "target_property_name": "#text" }
          ]
        }
      },
      {
        "big_title": {
          "type": "label",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 8, 18 ],
          "size": [ "default", "default" ],
          "font_scale_factor": 1.6,
          "shadow": true,
          "text": "§l§fCHAIN OF COMMAND"
        }
      },

      // left: the tree
      {
        "tree": {
          "type": "image",
          "texture": "textures/ui/skyclans/members_tree",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 8, 40 ],
          "size": [ 224, 188 ],
          "controls": [
            { "l_owner@sc_members.row_label": { "offset": [ 8, 24 ], "text": "OWNER" } },
            { "l_members@sc_members.row_label": { "offset": [ 8, 66 ], "text": "MEMBERS" } }
          ]
        }
      },

      // right top: SELECTED panel
      {
        "selected": {
          "type": "image",
          "texture": "textures/ui/skyclans/panel_selected",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 238, 24 ],
          "size": [ 106, 72 ],
          "controls": [
            { "title@sc_members.row_label": { "offset": [ 6, 5 ], "text": "SELECTED" } },
            {
              "face": {
                "type": "image",
                "layer": 1,
                "texture": "textures/ui/skyclans/face",
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "offset": [ 6, 16 ],
                "size": [ 18, 18 ]
              }
            },
            {
              "info": {
                "type": "label",
                "layer": 2,
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "offset": [ 28, 18 ],
                "size": [ 74, "default" ],
                "font_scale_factor": 0.6,
                "text": "#form_text",
                "bindings": [ { "binding_name": "#form_text" } ]
              }
            }
          ]
        }
      },

      // right bottom: WHO CAN DO WHAT (dots are in the texture)
      {
        "perms": {
          "type": "image",
          "texture": "textures/ui/skyclans/panel_perms",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 238, 100 ],
          "size": [ 106, 128 ],
          "controls": [
            { "title@sc_members.row_label": { "offset": [ 6, 5 ], "text": "WHO CAN DO WHAT" } },
            { "h_owner@sc_members.col_label": { "offset": [ 44, 16 ], "text": "§6OWNER" } },
            { "h_co@sc_members.col_label": { "offset": [ 62, 16 ], "text": "§aCO" } },
            { "h_member@sc_members.col_label": { "offset": [ 80, 16 ], "text": "§7MEMBER" } },
            { "r0@sc_members.perm_label": { "offset": [ 6, 27 ], "text": "Invite" } },
            { "r1@sc_members.perm_label": { "offset": [ 6, 40 ], "text": "Kick" } },
            { "r2@sc_members.perm_label": { "offset": [ 6, 53 ], "text": "Promote" } },
            { "r3@sc_members.perm_label": { "offset": [ 6, 66 ], "text": "Buy raids" } },
            { "r4@sc_members.perm_label": { "offset": [ 6, 79 ], "text": "Withdraw" } },
            { "r5@sc_members.perm_label": { "offset": [ 6, 92 ], "text": "Transfer" } },
            { "r6@sc_members.perm_label": { "offset": [ 6, 105 ], "text": "Deposit" } }
          ]
        }
      },

      // all the form buttons, by number
      {
        "buttons": {
          "type": "collection_panel",
          "collection_name": "form_buttons",
          "size": [ "100%", "100%" ],
          "layer": 5,
          "controls": [
            { "owner@sc_members.person_card": { "collection_index": 0, "offset": [ 78, 52 ] } },
            { "slot1@sc_members.person_card": { "collection_index": 1, "offset": [ 24, 118 ] } },
            { "slot2@sc_members.person_card": { "collection_index": 2, "offset": [ 132, 118 ] } },
            { "slot3@sc_members.person_card": { "collection_index": 3, "offset": [ 24, 168 ] } },
            { "slot4@sc_members.person_card": { "collection_index": 4, "offset": [ 132, 168 ] } },
            { "red@sc_members.red_button": { "collection_index": 5, "offset": [ 244, 61 ] } },
            { "blue@sc_members.blue_button": { "collection_index": 6, "offset": [ 244, 78 ] } },
            { "back@skyclans.back_button": { "collection_index": 7 } }
          ]
        }
      },
      {
        "close@skyclans.close_button": {
          "anchor_from": "top_right",
          "anchor_to": "top_right",
          "offset": [ -8, 6 ],
          "layer": 5
        }
      }
    ]
  },

  "row_label": {
    "type": "label",
    "layer": 2,
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "size": [ "default", "default" ],
    "font_scale_factor": 0.6,
    "color": [ 0.6, 0.64, 0.7 ]
  },

  "col_label": {
    "type": "label",
    "layer": 2,
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "size": [ 24, 10 ],
    "text_alignment": "center",
    "font_scale_factor": 0.5
  },

  "perm_label": {
    "type": "label",
    "layer": 2,
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "size": [ "default", "default" ],
    "font_scale_factor": 0.7,
    "color": [ 0.85, 0.87, 0.9 ]
  },

  // Card for one person (or the invite slot). Button picture = whole card art.
  "person_card": {
    "type": "button",
    "size": [ 84, 30 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "sound_name": "random.click",
    "focus_enabled": true,
    "button_mappings": [
      { "from_button_id": "button.menu_select", "to_button_id": "button.form_button_click", "mapping_type": "pressed" },
      { "from_button_id": "button.menu_ok", "to_button_id": "button.form_button_click", "mapping_type": "focused" }
    ],
    "bindings": [
      { "binding_type": "collection_details", "binding_collection_name": "form_buttons" },
      { "binding_name": "#form_button_text", "binding_type": "collection", "binding_collection_name": "form_buttons" },
      { "binding_type": "view", "source_property_name": "(not (#form_button_text = ''))", "target_property_name": "#visible" }
    ],
    "controls": [
      { "default": { "type": "panel" } },
      { "hover": { "type": "image", "texture": "textures/ui/skyclans/tile_hover", "layer": 3 } },
      { "pressed": { "type": "image", "texture": "textures/ui/skyclans/tile_pressed", "layer": 3 } },
      {
        "art": {
          "type": "image",
          "layer": 1,
          "bindings": [
            { "binding_name": "#form_button_texture", "binding_name_override": "#texture", "binding_type": "collection", "binding_collection_name": "form_buttons" },
            { "binding_name": "#form_button_texture_file_system", "binding_name_override": "#texture_file_system", "binding_type": "collection", "binding_collection_name": "form_buttons" }
          ]
        }
      },
      {
        "text": {
          "type": "label",
          "layer": 2,
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "offset": [ 28, 0 ],
          "size": [ 54, "default" ],
          "font_scale_factor": 0.65,
          "shadow": true,
          "text": "#form_button_text",
          "bindings": [ { "binding_name": "#form_button_text", "binding_type": "collection", "binding_collection_name": "form_buttons" } ]
        }
      }
    ]
  },

  "red_button": {
    "type": "button",
    "size": [ 60, 14 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "sound_name": "random.click",
    "focus_enabled": true,
    "button_mappings": [
      { "from_button_id": "button.menu_select", "to_button_id": "button.form_button_click", "mapping_type": "pressed" },
      { "from_button_id": "button.menu_ok", "to_button_id": "button.form_button_click", "mapping_type": "focused" }
    ],
    "bindings": [
      { "binding_type": "collection_details", "binding_collection_name": "form_buttons" },
      { "binding_name": "#form_button_text", "binding_type": "collection", "binding_collection_name": "form_buttons" },
      { "binding_type": "view", "source_property_name": "(not (#form_button_text = ''))", "target_property_name": "#visible" }
    ],
    "controls": [
      { "default": { "type": "image", "texture": "textures/ui/skyclans/btn_red" } },
      { "hover": { "type": "image", "texture": "textures/ui/skyclans/btn_red_hover" } },
      { "pressed": { "type": "image", "texture": "textures/ui/skyclans/btn_red_hover" } },
      {
        "text": {
          "type": "label",
          "layer": 2,
          "anchor_from": "center",
          "anchor_to": "center",
          "size": [ "default", "default" ],
          "font_scale_factor": 0.6,
          "text": "#form_button_text",
          "bindings": [ { "binding_name": "#form_button_text", "binding_type": "collection", "binding_collection_name": "form_buttons" } ]
        }
      }
    ]
  },

  "blue_button": {
    "type": "button",
    "size": [ 60, 14 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "sound_name": "random.click",
    "focus_enabled": true,
    "button_mappings": [
      { "from_button_id": "button.menu_select", "to_button_id": "button.form_button_click", "mapping_type": "pressed" },
      { "from_button_id": "button.menu_ok", "to_button_id": "button.form_button_click", "mapping_type": "focused" }
    ],
    "bindings": [
      { "binding_type": "collection_details", "binding_collection_name": "form_buttons" },
      { "binding_name": "#form_button_text", "binding_type": "collection", "binding_collection_name": "form_buttons" },
      { "binding_type": "view", "source_property_name": "(not (#form_button_text = ''))", "target_property_name": "#visible" }
    ],
    "controls": [
      { "default": { "type": "image", "texture": "textures/ui/skyclans/btn_blue" } },
      { "hover": { "type": "image", "texture": "textures/ui/skyclans/btn_blue_hover" } },
      { "pressed": { "type": "image", "texture": "textures/ui/skyclans/btn_blue_hover" } },
      {
        "text": {
          "type": "label",
          "layer": 2,
          "anchor_from": "center",
          "anchor_to": "center",
          "size": [ "default", "default" ],
          "font_scale_factor": 0.6,
          "text": "#form_button_text",
          "bindings": [ { "binding_name": "#form_button_text", "binding_type": "collection", "binding_collection_name": "form_buttons" } ]
        }
      }
    ]
  }
}

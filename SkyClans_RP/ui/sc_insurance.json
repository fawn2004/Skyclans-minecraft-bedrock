// SkyClans "Insurance Vault" screen. Title marker "§s§c§4".
//   title (after marker) -> small grey line, e.g. clan name
//   body                 -> "Last claim" text (bottom left)
//   buttons 0-3  -> the four tier cards (picture = whole card art; text = name / % / description)
//   buttons 4-7  -> top line of each card ("NEXT UNLOCK" / "LOCKED")   - text only, not pressable
//   buttons 8-11 -> text on each card's bar ("BUY · $50,000")          - text only, not pressable
//   button 12    -> BACK
// Everything is placed by position + button number: no grids, no text checks.
{
  "namespace": "sc_insurance",

  "screen": {
    "type": "image",
    "texture": "textures/ui/skyclans/window",
    "size": [ 352, 236 ],
    "controls": [
      {
        "icon": {
          "type": "image",
          "texture": "textures/ui/skyclans/head_insurance",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 8, 12 ],
          "size": [ 18, 18 ]
        }
      },
      {
        "small_line": {
          "type": "label",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 30, 6 ],
          "size": [ 160, 10 ],
          "color": [ 0.62, 0.66, 0.72 ],
          "font_scale_factor": 0.8,
          "text": "#text",
          "bindings": [
            { "binding_name": "#title_text" },
            { "binding_type": "view", "source_property_name": "(#title_text - '§s§c§4')", "target_property_name": "#text" }
          ]
        }
      },
      {
        "big_title": {
          "type": "label",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 30, 18 ],
          "size": [ "default", "default" ],
          "font_scale_factor": 1.6,
          "shadow": true,
          "text": "§l§fINSURANCE VAULT"
        }
      },
      {
        "info": {
          "type": "label",
          "anchor_from": "top_right",
          "anchor_to": "top_right",
          "offset": [ -8, 24 ],
          "size": [ 140, "default" ],
          "text_alignment": "right",
          "font_scale_factor": 0.6,
          "color": [ 0.75, 0.78, 0.84 ],
          "text": "Get back part of the money stolen in a raid. Unlock each tier in order."
        }
      },

      // bottom strip
      {
        "last_claim": {
          "type": "image",
          "texture": "textures/ui/skyclans/chip",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 8, 198 ],
          "size": [ 216, 22 ],
          "controls": [
            { "l@sc_insurance.strip_label": { "anchor_from": "left_middle", "anchor_to": "left_middle", "offset": [ 6, 0 ], "text": "Last claim" } },
            {
              "r": {
                "type": "label",
                "anchor_from": "right_middle",
                "anchor_to": "right_middle",
                "offset": [ -6, 0 ],
                "size": [ "default", "default" ],
                "font_scale_factor": 0.7,
                "color": [ 0.55, 0.59, 0.66 ],
                "text": "#form_text",
                "bindings": [ { "binding_name": "#form_text" } ]
              }
            }
          ]
        }
      },
      {
        "covers": {
          "type": "image",
          "texture": "textures/ui/skyclans/chip",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 228, 198 ],
          "size": [ 116, 22 ],
          "controls": [
            { "l@sc_insurance.strip_label": { "anchor_from": "left_middle", "anchor_to": "left_middle", "offset": [ 6, 0 ], "text": "§eCovers" } },
            { "r@sc_insurance.strip_label": { "anchor_from": "right_middle", "anchor_to": "right_middle", "offset": [ -6, 0 ], "text": "Money only" } }
          ]
        }
      },

      // all the form buttons, by number
      {
        "buttons": {
          "type": "collection_panel",
          "collection_name": "form_buttons",
          "size": [ "100%", "100%" ],
          "layer": 5,
          "controls": [
            { "card0@sc_insurance.tier_card": { "collection_index": 0, "offset": [ 8, 46 ] } },
            { "card1@sc_insurance.tier_card": { "collection_index": 1, "offset": [ 93, 46 ] } },
            { "card2@sc_insurance.tier_card": { "collection_index": 2, "offset": [ 178, 46 ] } },
            { "card3@sc_insurance.tier_card": { "collection_index": 3, "offset": [ 263, 46 ] } },

            { "status0@sc_insurance.status_label": { "collection_index": 4, "offset": [ 8, 50 ] } },
            { "status1@sc_insurance.status_label": { "collection_index": 5, "offset": [ 93, 50 ] } },
            { "status2@sc_insurance.status_label": { "collection_index": 6, "offset": [ 178, 50 ] } },
            { "status3@sc_insurance.status_label": { "collection_index": 7, "offset": [ 263, 50 ] } },

            { "price0@sc_insurance.price_label": { "collection_index": 8, "offset": [ 16, 170 ] } },
            { "price1@sc_insurance.price_label": { "collection_index": 9, "offset": [ 101, 170 ] } },
            { "price2@sc_insurance.price_label": { "collection_index": 10, "offset": [ 186, 170 ] } },
            { "price3@sc_insurance.price_label": { "collection_index": 11, "offset": [ 271, 170 ] } },

            { "back@skyclans.back_button": { "collection_index": 12 } }
          ]
        }
      },
      {
        "close@skyclans.close_button": {
          "anchor_from": "top_right",
          "anchor_to": "top_right",
          "offset": [ -8, 6 ],
          "layer": 5
        }
      }
    ]
  },

  "strip_label": {
    "type": "label",
    "size": [ "default", "default" ],
    "font_scale_factor": 0.7,
    "color": [ 0.85, 0.87, 0.9 ]
  },

  // Text-only labels that read another button's text (not pressable).
  "status_label": {
    "type": "label",
    "layer": 6,
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "size": [ 81, 10 ],
    "text_alignment": "center",
    "font_scale_factor": 0.55,
    "text": "#form_button_text",
    "bindings": [ { "binding_name": "#form_button_text", "binding_type": "collection", "binding_collection_name": "form_buttons" } ]
  },

  "price_label": {
    "type": "label",
    "layer": 6,
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "size": [ 65, 10 ],
    "text_alignment": "center",
    "font_scale_factor": 0.55,
    "text": "#form_button_text",
    "bindings": [ { "binding_name": "#form_button_text", "binding_type": "collection", "binding_collection_name": "form_buttons" } ]
  },

  "tier_card": {
    "type": "button",
    "size": [ 81, 146 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "sound_name": "random.click",
    "focus_enabled": true,
    "button_mappings": [
      { "from_button_id": "button.menu_select", "to_button_id": "button.form_button_click", "mapping_type": "pressed" },
      { "from_button_id": "button.menu_ok", "to_button_id": "button.form_button_click", "mapping_type": "focused" }
    ],
    "bindings": [ { "binding_type": "collection_details", "binding_collection_name": "form_buttons" } ],
    "controls": [
      { "default": { "type": "panel" } },
      { "hover": { "type": "image", "texture": "textures/ui/skyclans/tile_hover", "layer": 3 } },
      { "pressed": { "type": "image", "texture": "textures/ui/skyclans/tile_pressed", "layer": 3 } },
      {
        "art": {
          "type": "image",
          "layer": 1,
          "bindings": [
            { "binding_name": "#form_button_texture", "binding_name_override": "#texture", "binding_type": "collection", "binding_collection_name": "form_buttons" },
            { "binding_name": "#form_button_texture_file_system", "binding_name_override": "#texture_file_system", "binding_type": "collection", "binding_collection_name": "form_buttons" }
          ]
        }
      },
      {
        "text": {
          "type": "label",
          "layer": 2,
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": [ 0, 68 ],
          "size": [ 75, "default" ],
          "text_alignment": "center",
          "font_scale_factor": 0.75,
          "shadow": true,
          "text": "#form_button_text",
          "bindings": [ { "binding_name": "#form_button_text", "binding_type": "collection", "binding_collection_name": "form_buttons" } ]
        }
      }
    ]
  }
}

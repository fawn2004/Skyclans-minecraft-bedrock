// SkyClans list screen: a simple grid of tiles, 4 per row, up to 12 per page.
// Used by the Sky Shop (categories, then items). Title marker "§s§c§6".
//   title (after marker) -> big title, e.g. "§l§fSKY SHOP"
//   body                 -> small grey line above it, e.g. "Balance $0"
//   buttons              -> tiles in order; picture = icon (vanilla item/block), text = 2 lines
// Built like the main menu grid (which opens instantly): one button per tile,
// a fixed background, the icon and the text - no text checks, no placing by number.
{
  "namespace": "sc_list",

  "screen": {
    "type": "image",
    "texture": "textures/ui/skyclans/shop_window",
    "size": [ 352, 236 ],
    "controls": [
      {
        "small_line": {
          "type": "label",
          "layer": 2,
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 8, 6 ],
          "size": [ 260, 10 ],
          "color": [ 0.62, 0.66, 0.72 ],
          "font_scale_factor": 0.8,
          "text": "#form_text",
          "bindings": [ { "binding_name": "#form_text" } ]
        }
      },
      {
        "big_title": {
          "type": "label",
          "layer": 2,
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 8, 18 ],
          "size": [ "default", "default" ],
          "font_scale_factor": 1.6,
          "shadow": true,
          "text": "#text",
          "bindings": [
            { "binding_name": "#title_text" },
            { "binding_type": "view", "source_property_name": "(#title_text - '§s§c§6')", "target_property_name": "#text" }
          ]
        }
      },
      {
        "close@skyclans.close_button": {
          "anchor_from": "top_right",
          "anchor_to": "top_right",
          "offset": [ -8, 6 ],
          "layer": 5
        }
      },
      {
        "grid": {
          "type": "grid",
          "layer": 2,
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": [ 0, 46 ],
          // width fits 4 tiles; rows are only added for tiles that exist (no empty boxes)
          "size": [ 336, "default" ],
          "grid_rescaling_type": "horizontal",
          "grid_item_template": "sc_list.tile",
          "collection_name": "form_buttons",
          "bindings": [
            { "binding_name": "#form_button_length", "binding_name_override": "#maximum_grid_items" }
          ]
        }
      }
    ]
  },

  "tile": {
    "type": "panel",
    "size": [ 84, 60 ],
    "controls": [ { "button@sc_list.tile_button": {} } ]
  },

  "tile_button": {
    "type": "button",
    "size": [ 80, 56 ],
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "sound_name": "random.click",
    "focus_enabled": true,
    "button_mappings": [
      { "from_button_id": "button.menu_select", "to_button_id": "button.form_button_click", "mapping_type": "pressed" },
      { "from_button_id": "button.menu_ok", "to_button_id": "button.form_button_click", "mapping_type": "focused" }
    ],
    "bindings": [ { "binding_type": "collection_details", "binding_collection_name": "form_buttons" } ],
    "controls": [
      { "default": { "type": "image", "texture": "textures/ui/skyclans/list_tile" } },
      { "hover": { "type": "image", "texture": "textures/ui/skyclans/shop_cat_hover" } },
      { "pressed": { "type": "image", "texture": "textures/ui/skyclans/shop_cat_hover" } },
      {
        "icon": {
          "type": "image",
          "layer": 2,
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": [ 0, 7 ],
          "size": [ 22, 22 ],
          "bindings": [
            { "binding_name": "#form_button_texture", "binding_name_override": "#texture", "binding_type": "collection", "binding_collection_name": "form_buttons" },
            { "binding_name": "#form_button_texture_file_system", "binding_name_override": "#texture_file_system", "binding_type": "collection", "binding_collection_name": "form_buttons" }
          ]
        }
      },
      {
        "text": {
          "type": "label",
          "layer": 3,
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "offset": [ 0, -5 ],
          "size": [ "100% - 4px", "default" ],
          "text_alignment": "center",
          "font_scale_factor": 0.75,
          "shadow": true,
          "text": "#form_button_text",
          "bindings": [ { "binding_name": "#form_button_text", "binding_type": "collection", "binding_collection_name": "form_buttons" } ]
        }
      }
    ]
  }
}
